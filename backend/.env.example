# Back end variables. Copy to .env for development. Never commit .env (it is git-ignored).
# In production there is no .env file: set these on the Railway service instead.
#
# Lines marked REQUIRED stop the API from starting in production when they are missing or unsafe.
# The settings read both the DJANGO_ names and the plain names (SECRET_KEY, ALLOWED_HOSTS,
# FRONTEND_BASE_URL, CELERY_BROKER_URL).
#
# Check a production environment without starting the server (it lists EVERY missing or invalid
# variable at once and prints no secrets):
#     python manage.py check_env
# The full table for Railway, with where each value comes from: docs/deployment/railway-variables.md

# ---------------------------------------------------------------------------------------------
# Which settings file to use. Development: config.settings.local. Production: the Docker image
# already sets config.settings.production, so leave this out on Railway.
# ---------------------------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.local

# REQUIRED. A long random string: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-local-only
# Production must be false (the app refuses to start otherwise). Development settings turn it on.
DEBUG=false
# REQUIRED in production. The API host name only, comma separated. Never *.
# Example: api.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------------------------
# Database and Redis. Railway provides both as DATABASE_URL and REDIS_URL when you add the plugins.
# ---------------------------------------------------------------------------------------------
# REQUIRED. PostgreSQL only.
DATABASE_URL=postgres://wo:wo@localhost:5433/wo
DB_CONN_MAX_AGE=60
# Production default is require. Use disable only for a database on a private network without TLS.
DB_SSLMODE=require
# REQUIRED in production. One Redis for the cache and the Celery queue.
# In development the cache and the queue default to the Docker Redis on port 6380.
REDIS_URL=
# Optional overrides if the cache and the queue must use different Redis databases.
REDIS_CACHE_URL=redis://localhost:6380/1
CELERY_BROKER_URL=redis://localhost:6380/0

# ---------------------------------------------------------------------------------------------
# Addresses. Production uses https and two subdomains of one domain.
# ---------------------------------------------------------------------------------------------
# REQUIRED in production. The front end, no trailing slash. Used in every link in an email.
# Example: https://app.example.com
FRONTEND_URL=http://localhost:5173
# REQUIRED in production. This API, no trailing slash. Used in one click unsubscribe links.
# Example: https://api.example.com
API_BASE_URL=http://localhost:8000
# REQUIRED in production. Origins the browser may call the API from, comma separated, https only.
# Example: https://app.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Origins trusted for the CSRF check. Defaults to the CORS origins plus API_BASE_URL.
CSRF_TRUSTED_ORIGINS=
# REQUIRED in production, set to 1: the platform's router adds one hop to X-Forwarded-For. Without
# it every visitor shares one rate limit. Keep 0 in development.
NUM_PROXIES=0

# ---------------------------------------------------------------------------------------------
# Sign in. A short lived access token is kept in memory by the browser. A refresh token lives in an
# HttpOnly cookie that the API sets on its own host and that is sent only to /api/v1/auth/.
# ---------------------------------------------------------------------------------------------
JWT_ISSUER=wo-community
# REQUIRED in production. Ed25519 keys in PEM form with the line breaks written as \n.
# Generate: python -c "from config.settings.keys import ephemeral_jwt_keys as k; a,b=k(); print(a.replace(chr(10),'\\n')); print(b.replace(chr(10),'\\n'))"
# Empty in development: a throwaway key is made on each start.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Must stay true in production (the cookie is only sent over https).
REFRESH_COOKIE_SECURE=false
# Lax is right while the app and the API share one registrable domain (app. and api. subdomains).
REFRESH_COOKIE_SAMESITE=Lax
# REQUIRED in production. Comma separated Fernet keys.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=

# ---------------------------------------------------------------------------------------------
# Email. Development keeps messages in memory (open the mail catcher at http://localhost:8025 if
# you run the mail container). Production sends through Resend.
# ---------------------------------------------------------------------------------------------
# REQUIRED in production. One of:
#   apps.integrations.email.resend.ResendEmailAdapter  (real email through Resend)
#   apps.integrations.email.fake.FakeEmailAdapter      (the app starts, but NO email is sent)
#   apps.integrations.email.smtp.SmtpEmailAdapter      (a local mail catcher, not for production)
EMAIL_ADAPTER=apps.integrations.email.fake.FakeEmailAdapter
# REQUIRED with Resend. An API key that can send, from resend.com/api-keys.
RESEND_API_KEY=
# REQUIRED with Resend. The signing secret of the webhook that points at
# https://<api host>/api/v1/webhooks/email/resend (it starts with whsec_).
RESEND_WEBHOOK_SECRET=
# REQUIRED with Resend, either both of these (account mail and newsletters from different
# subdomains, the better setup) or DEFAULT_FROM_EMAIL alone, which both then use.
# DEFAULT_FROM_EMAIL=WO Community <hello@mail.example.com>
EMAIL_FROM_TRANSACTIONAL=WO Community <no-reply@mail.example.com>
EMAIL_FROM_MARKETING=WO Community <community@news.example.com>
EMAIL_REPLY_TO=
# https address of the logo shown in emails (a PNG). Empty shows the name as text.
EMAIL_LOGO_URL=
# The sign off at the bottom of every email.
EMAIL_SIGNOFF=
# The organisation name and postal line in newsletter footers.
CAMPAIGN_FOOTER=WO Community
# Day sending began, as YYYY-MM-DD. New domains are limited to a small hourly volume that grows.
EMAIL_WARMUP_START=
EMAIL_HOURLY_CAP=-1
# DKIM selectors the email health page checks, comma separated.
EMAIL_DKIM_SELECTORS=

# ---------------------------------------------------------------------------------------------
# File storage. Development uses an in memory fake. Production uses Cloudflare R2 (S3 compatible).
# ---------------------------------------------------------------------------------------------
# REQUIRED in production: apps.integrations.storage.s3.S3Storage
STORAGE_ADAPTER=apps.integrations.storage.fake.FakeStorage
# R2: https://<account id>.r2.cloudflarestorage.com . Empty means AWS S3. MinIO: http://localhost:9000
STORAGE_ENDPOINT_URL=
# R2: auto
STORAGE_REGION=us-east-1
# R2: put (R2 cannot take a browser form upload). S3 and MinIO: post.
STORAGE_UPLOAD_METHOD=post
# An R2 API token's access key and secret, limited to these buckets.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Where a file waits until it has been checked. Never public.
STORAGE_QUARANTINE_BUCKET=wo-quarantine
# Covers, avatars and other images, public through MEDIA_BASE_URL.
STORAGE_MEDIA_BUCKET=wo-media
# Support attachments and course documents. Never public: members get short lived signed links.
STORAGE_PRIVATE_BUCKET=wo-private
# Write once bucket for the daily audit hash. Never public.
STORAGE_ANCHOR_BUCKET=wo-anchor
# REQUIRED in production. The public https address of the media bucket (R2 custom domain such as
# https://media.example.com). Image links are built from it.
MEDIA_BASE_URL=http://localhost:9000/wo-media
# REQUIRED in production: apps.integrations.malware.clamd.ClamdScanner (and a ClamAV service).
MALWARE_SCANNER=apps.integrations.malware.fake.FakeScanner
CLAMD_HOST=localhost
CLAMD_PORT=3310

# ---------------------------------------------------------------------------------------------
# Optional services. The two fake classes below are for development only: in production leave
# GOOGLE_TOKEN_VERIFIER and PASSWORD_BREACH_CHECKER unset so the real ones are used.
# ---------------------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_TOKEN_VERIFIER=apps.integrations.identity.fake.FakeGoogleVerifier
PASSWORD_BREACH_CHECKER=apps.integrations.passwords.fake.FakeBreachChecker

# Video meetings for mentoring sessions. OPTIONAL: with nothing set, booked sessions get made-up
# meeting links and the production check only warns. For real links choose a provider, set its
# adapter, and then its credentials are REQUIRED.
# google_meet or zoom
# MEETING_DEFAULT_PROVIDER=google_meet
# Google Meet (these three are then REQUIRED):
# MEETING_GOOGLE_MEET_ADAPTER=apps.integrations.meetings.google.GoogleMeetProvider
# Zoom (with MEETING_DEFAULT_PROVIDER=zoom; its three credentials are then REQUIRED):
# MEETING_ZOOM_ADAPTER=apps.integrations.meetings.zoom.ZoomProvider
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
GOOGLE_MEET_REFRESH_TOKEN=
GOOGLE_MEET_CALENDAR_ID=primary
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Launch toolkit. REQUIRED in production, one of two ways:
#  a) a real model: AI_PROVIDER=http with AI_BASE_URL and AI_API_KEY, and RESEARCH_PROVIDER set to
#     apps.toolkit.ai.research.web.WebResearchProvider with RESEARCH_ALLOWED_DOMAINS; or
#  b) every tool switched off: TOOLKIT_FEATURE_SCORE, _PLAN, _FORECAST, _DECKS, _PROTOTYPES and
#     _PARTNER all set to false (then none of the AI or research variables are needed).
# AI_PROVIDER=http
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL_DEFAULT=
# RESEARCH_PROVIDER=apps.toolkit.ai.research.web.WebResearchProvider
# TOOLKIT_FEATURE_SCORE=false
# TOOLKIT_FEATURE_PLAN=false
# TOOLKIT_FEATURE_FORECAST=false
# TOOLKIT_FEATURE_DECKS=false
# TOOLKIT_FEATURE_PROTOTYPES=false
# TOOLKIT_FEATURE_PARTNER=false
# Optional: a second provider to fall back on, and a model per kind of task.
# AI_FALLBACK_PROVIDER=
# AI_MODEL_RESEARCH=
# AI_MODEL_WRITER=
# AI_MODEL_FINANCE=
# AI_MODEL_DECK=
# AI_MODEL_PROTOTYPE=
# AI_MODEL_REVIEWER=
# AI_MODEL_PARTNER=
AI_REQUEST_TIMEOUT_SECONDS=60
AI_PARTNER_REPLY_TIMEOUT_SECONDS=10
AI_DAILY_RUN_CEILING=400
RESEARCH_ALLOWED_DOMAINS=
RESEARCH_SEARCH_URL=
RESEARCH_SEARCH_KEY=
TOOLKIT_MAX_VENTURES_PER_MEMBER=3
TOOLKIT_MAX_ACTIVE_JOBS=4
EXPORT_URL_TTL=900
EXPORT_RETENTION_DAYS=7

# Public pages are cached by Cloudflare; a change purges them. Optional: with the fake purger the
# app starts, but a changed public page keeps its cached copy until it expires. With
# apps.integrations.cdn.cloudflare.CloudflarePurger the three values below are REQUIRED.
CDN_PURGER=apps.integrations.cdn.fake.LoggingPurger
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CDN_ORIGIN_URL=

ANALYTICS_SINK=apps.integrations.analytics.sinks.LoggingSink
FEATURE_PAYMENTS_ENABLED=false

# ---------------------------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------------------------
SENTRY_DSN=
ENVIRONMENT=local
RELEASE=dev
LOG_LEVEL=INFO
# Gunicorn (production). The platform sets PORT itself.
# WEB_CONCURRENCY=3
# GUNICORN_THREADS=2
# GUNICORN_TIMEOUT=30
# Bearer token that protects /metrics. Leave empty to keep it closed.
METRICS_TOKEN=
# Serve the OpenAPI description at /api/v1/schema/. Leave off in production.
SERVE_API_SCHEMA=false

# ---------------------------------------------------------------------------------------------
# Tuning and rarely changed settings. All optional; the values shown are the defaults.
# ---------------------------------------------------------------------------------------------
# Trial run of the production settings on one machine (no https, hosts are localhost). Switches off
# the https and localhost checks only. NEVER set it on a real deployment.
# LOCAL_PRODUCTION_RUN=false
# Which proxy addresses gunicorn trusts for X-Forwarded-* headers (it reads FORWARDED_ALLOW_IPS).
# FORWARDED_ALLOW_IPS=*
# The first administrator's password for `manage.py create_super_admin` (it asks if this is unset).
# ADMIN_PASSWORD=
# Where Prometheus keeps its files when gunicorn runs several workers.
# PROMETHEUS_MULTIPROC_DIR=
# Tracing: an OTLP collector address, and the share of requests traced (0 to 1).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACE_SAMPLE_RATIO=0.1
# Raise on a bad analytics event instead of dropping it. Keep false in production.
ANALYTICS_STRICT=false
# Production sets this true itself: a partition is dropped only after it was archived.
ANALYTICS_REQUIRE_ARCHIVE=false
# Lock the daily audit hash object so it cannot be changed. Needs a bucket with object lock.
STORAGE_ANCHOR_OBJECT_LOCK=true
AUDIT_ANCHOR_RETENTION_DAYS=2555
# Outgoing mail in development: the mail catcher.
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1026
# How the email health page asks the DNS.
EMAIL_DNS_RESOLVER=apps.integrations.dns.SystemResolver
# Newsletters go out in batches of this size with this pause between them.
CAMPAIGN_BATCH_SIZE=50
CAMPAIGN_BATCH_DELAY_SECONDS=5
# Limits on what one member can do in a day.
FEED_POSTS_PER_DAY=20
FEED_COMMENTS_PER_DAY=200
FEED_REPORTS_PER_DAY=20
MENTORSHIP_MIN_NOTICE_HOURS=12
SUPPORT_SLA_HOURS=24
# Fetchers that call other sites. Tests and development swap them for fakes.
YOUTUBE_TITLE_LOOKUP=apps.integrations.youtube.oembed_title
LINK_PREVIEW_FETCHER=apps.integrations.linkpreview.fetcher.WebFetcher
CALENDAR_FEED_READER=apps.integrations.calendars.web.WebFeedReader
# Launch toolkit sizes and limits.
DECK_MAX_SLIDES=100
DECK_VERSIONS_KEPT=30
PLAN_VERSIONS_KEPT=20
PROTOTYPE_MAX_SCREENS=20
VENTURE_DELETE_GRACE_DAYS=14
TOOLKIT_PARALLEL_RESEARCH=true
