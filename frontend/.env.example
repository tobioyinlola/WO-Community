# Front end variables. Vite reads only names that start with VITE_ and puts them in the built files,
# so never put a secret here. Copy to .env.local for development. .env files are git-ignored.

# The public https address of the API, with no trailing slash and no path.
# REQUIRED for a production build (npm run build stops without it).
# Leave it empty in development: requests go to the same origin and Vite forwards /api to the API.
VITE_API_URL=

# Development only: where Vite forwards /api. Defaults to http://localhost:8000.
# VITE_DEV_API_PROXY=http://localhost:8000
